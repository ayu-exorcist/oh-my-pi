{
  "name": "@ayulab/oh-my-pi",
  "version": "0.2.0",
  "description": "Personal Pi toolkit: extensions, skills, prompts, and themes",
  "keywords": [
    "extensions",
    "pi",
    "pi-package",
    "prompts",
    "skills",
    "themes",
    "toolkit"
  ],
  "license": "GPL-3.0",
  "author": "ayu",
  "files": [
    "skills",
    "prompts",
    "themes",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:open": "vitest run --coverage && npx serve coverage -p 9876 -o",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf coverage .oxlintcache .oxfmtcache *.tsbuildinfo",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "check": "tsc --noEmit && pnpm run lint && pnpm run fmt:check && pnpm run test",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run coverage",
    "setup": "oxnode scripts/setup.ts",
    "teardown": "oxnode scripts/teardown.ts",
    "release": "oxnode scripts/publish.ts",
    "release:dry": "oxnode scripts/publish.ts --dry-run"
  },
  "dependencies": {
    "@ayulab/pi-rewind": "workspace:*",
    "@ayulab/pi-undoredo": "workspace:*",
    "pi-mcp-adapter": "2.6.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.4",
    "@oxc-node/cli": "^0.1.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "bundledDependencies": [
    "@ayulab/pi-rewind",
    "@ayulab/pi-undoredo",
    "pi-mcp-adapter"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "pi": {
    "extensions": [
      "node_modules/@ayulab/pi-rewind/index.ts",
      "node_modules/@ayulab/pi-undoredo/index.ts",
      "node_modules/pi-mcp-adapter/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
