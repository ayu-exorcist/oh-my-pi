{
  "name": "@ayulab/oh-my-pi",
  "version": "0.3.2",
  "description": "Personal Pi toolkit: extensions, skills, prompts, and themes",
  "keywords": [
    "extensions",
    "pi",
    "pi-package",
    "prompts",
    "skills",
    "themes",
    "toolkit"
  ],
  "homepage": "https://github.com/ayu-exorcist/oh-my-pi#readme",
  "bugs": {
    "url": "https://github.com/ayu-exorcist/oh-my-pi/issues"
  },
  "license": "GPL-3.0",
  "author": "ayu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-exorcist/oh-my-pi.git"
  },
  "files": [
    "skills",
    "prompts",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:open": "vitest run --coverage && pnpm dlx serve coverage -p 9876 -o",
    "typecheck": "tsc --noEmit",
    "clean": "pnpm dlx rimraf --glob coverage .oxlintcache .oxfmtcache \"*.tsbuildinfo\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "check": "tsc --noEmit && pnpm run lint && pnpm run fmt:check && pnpm run test",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run coverage",
    "setup": "oxnode scripts/setup.ts",
    "teardown": "oxnode scripts/teardown.ts",
    "build": "turbo run build --filter=\"!@ayulab/oh-my-pi\"",
    "build:all": "turbo run build",
    "release": "oxnode scripts/publish.ts",
    "release:dry": "oxnode scripts/publish.ts --dry-run"
  },
  "dependencies": {
    "@ayulab/pi-brief": "workspace:*",
    "@ayulab/pi-clarify": "workspace:*",
    "@ayulab/pi-rewind": "workspace:*",
    "@ayulab/pi-undo-redo": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.1",
    "@oxc-node/cli": "^0.1.0",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "bundledDependencies": [
    "@ayulab/pi-brief",
    "@ayulab/pi-clarify",
    "@ayulab/pi-rewind",
    "@ayulab/pi-undo-redo"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "pi": {
    "extensions": [
      "!node_modules/@ayulab/pi-clarify",
      "!node_modules/@ayulab/pi-brief",
      "node_modules/@ayulab/pi-rewind",
      "!node_modules/@ayulab/pi-undo-redo"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
