{
  "name": "@ayulab/pi-undo-redo",
  "version": "0.2.1",
  "description": "Pi extension providing /undo and /redo commands",
  "keywords": [
    "checkpoint",
    "extension",
    "pi",
    "pi-package",
    "redo",
    "undo"
  ],
  "homepage": "https://github.com/ayu-exorcist/oh-my-pi/tree/main/extensions/pi-undo-redo#readme",
  "bugs": {
    "url": "https://github.com/ayu-exorcist/oh-my-pi/issues"
  },
  "license": "GPL-3.0",
  "author": "ayu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-exorcist/oh-my-pi.git",
    "directory": "extensions/pi-undo-redo"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "postbuild": "pi-dist-manifest"
  },
  "dependencies": {
    "@ayulab/pi-checkpoint": "workspace:*",
    "@ayulab/runtime-core": "workspace:*"
  },
  "devDependencies": {
    "@ayulab/repo-tools": "workspace:*",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
