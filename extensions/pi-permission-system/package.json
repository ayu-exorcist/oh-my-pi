{
  "name": "@ayulab/pi-permission-system",
  "version": "0.1.0",
  "description": "Permission enforcement extension for the Pi coding agent, adapted for oh-my-pi.",
  "keywords": [
    "access-control",
    "authorization",
    "coding-agent",
    "extension",
    "permission",
    "pi",
    "pi-extension",
    "pi-package",
    "policy",
    "security"
  ],
  "homepage": "https://github.com/ayu-exorcist/oh-my-pi/tree/main/extensions/pi-permission-system#readme",
  "bugs": {
    "url": "https://github.com/ayu-exorcist/oh-my-pi/issues"
  },
  "license": "MIT",
  "author": "ayu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-exorcist/oh-my-pi.git",
    "directory": "extensions/pi-permission-system"
  },
  "files": [
    "src",
    "test",
    "config/config.example.json",
    "schemas/permissions.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": "./src/service.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "postbuild": "node ../../scripts/dist-manifest.mjs"
  },
  "dependencies": {
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.75.5",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
