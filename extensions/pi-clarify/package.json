{
  "name": "@ayulab/pi-clarify",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension providing structured one-question clarification prompts",
  "keywords": [
    "clarify",
    "extension",
    "pi",
    "pi-package",
    "prompt",
    "question"
  ],
  "homepage": "https://github.com/ayu-exorcist/oh-my-pi/tree/main/extensions/pi-clarify#readme",
  "bugs": {
    "url": "https://github.com/ayu-exorcist/oh-my-pi/issues"
  },
  "license": "GPL-3.0",
  "author": "ayu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-exorcist/oh-my-pi.git",
    "directory": "extensions/pi-clarify"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "postbuild": "pi-dist-manifest"
  },
  "dependencies": {
    "@ayulab/runtime-core": "workspace:*"
  },
  "devDependencies": {
    "@ayulab/repo-tools": "workspace:*",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
