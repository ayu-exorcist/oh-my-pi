{
  "name": "@ayulab/pi-checkpoint",
  "version": "0.3.0",
  "description": "File-level checkpoint engine using git bare repos",
  "keywords": [
    "checkpoint",
    "git",
    "pi",
    "snapshot",
    "undo"
  ],
  "homepage": "https://github.com/ayu-exorcist/oh-my-pi/tree/main/sdk/pi-checkpoint#readme",
  "bugs": {
    "url": "https://github.com/ayu-exorcist/oh-my-pi/issues"
  },
  "license": "GPL-3.0",
  "author": "ayu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-exorcist/oh-my-pi.git",
    "directory": "sdk/pi-checkpoint"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./repo-manager": "./src/repo-manager.ts",
    "./repo-provider": "./src/repo-provider.ts",
    "./session-checkpoint-storage": "./src/session-checkpoint-storage.ts",
    "./session-state-map": "./src/session-state-map.ts",
    "./testing": "./src/testing/index.ts",
    "./resolver": "./src/resolver.ts",
    "./exec": "./src/exec.ts",
    "./diff-parser": "./src/diff-parser.ts",
    "./guards": "./src/guards.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "postbuild": "node ../../scripts/dist-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
