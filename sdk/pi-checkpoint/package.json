{
  "name": "@ayulab/pi-checkpoint",
  "version": "0.6.1",
  "description": "File-level checkpoint engine using git bare repos",
  "keywords": [
    "checkpoint",
    "git",
    "pi",
    "snapshot"
  ],
  "homepage": "https://github.com/ayu-exorcist/oh-my-pi/tree/main/sdk/pi-checkpoint#readme",
  "bugs": {
    "url": "https://github.com/ayu-exorcist/oh-my-pi/issues"
  },
  "license": "GPL-3.0",
  "author": "ayu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayu-exorcist/oh-my-pi.git",
    "directory": "sdk/pi-checkpoint"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "postbuild": "pi-dist-manifest"
  },
  "dependencies": {
    "@ayulab/runtime-core": "workspace:*"
  },
  "devDependencies": {
    "@ayulab/repo-tools": "workspace:*",
    "@types/node": "^26.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
