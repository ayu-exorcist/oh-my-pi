{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "paths": {
      "@ayulab/pi-compact": ["./extensions/pi-compact/src/index.ts"],
      "@ayulab/pi-compact/*": ["./extensions/pi-compact/src/*"],
      "@ayulab/pi-checkpoint": ["./sdk/pi-checkpoint/src/index.ts"],
      "@ayulab/pi-checkpoint/*": ["./sdk/pi-checkpoint/src/*"],
      "@ayulab/pi-checkpoint/testing": ["./sdk/pi-checkpoint/src/testing/index.ts"],
      "@ayulab/pi-trace-engine": ["./sdk/pi-trace-engine/src/index.ts"],
      "@ayulab/pi-trace-engine/*": ["./sdk/pi-trace-engine/src/*"]
    }
  },
  "include": ["sdk/**/*.ts", "extensions/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules"]
}
